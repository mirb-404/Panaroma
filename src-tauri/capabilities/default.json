{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (served from localhost in release builds)",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:47801/*",
      "http://localhost:47811/*",
      "http://localhost:47821/*",
      "http://localhost:47831/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "allow-app-ready",
    "allow-set-fullscreen",
    "allow-is-fullscreen",
    "allow-quit-app",
    "allow-steam-sounds-available",
    "allow-read-steam-sound",
    "allow-import-startup-video",
    "allow-clear-startup-video",
    "dialog:allow-open",
    "allow-yt-signed-in",
    "allow-yt-api",
    "allow-yt-open-sign-in",
    "allow-yt-close-sign-in",
    "allow-yt-sign-out",
    "allow-yt-channel-feeds"
  ]
}