# Development only. Copy to `.env.local` to skip the sign-in setup while running
# `pnpm tauri dev`. These values are stripped from release builds: the installer
# never contains your credentials, and users create their own in
# Settings → Sign-in setup.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
# Optional: lets signed-out browsing work in dev.
VITE_YT_API_KEY=
