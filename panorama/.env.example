# Optional build-time defaults. Copy to `.env.local` before `pnpm tauri build`.
# Users can always override these in Settings. Anything here is embedded in the
# installer and therefore public: restrict the API key to the YouTube Data API v3.
VITE_YT_API_KEY=
# OAuth client of type "Desktop app" (Google Cloud Console > Credentials).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
